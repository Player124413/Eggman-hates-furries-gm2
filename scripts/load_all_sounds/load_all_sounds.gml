function load_all_sounds() {
	// load_all_sounds — explicitly load every sound the game expects.
	// The original game scanned the sound/ folder at runtime with
	// file_find_* + execute_string, which are removed in GMS2.
	// Import each file below as an audio asset first (asset name =
	// filename without extension, e.g. sndThunder1.wav -> sndThunder1).
	// Missing assets return -1 and that sound is silently skipped.

	global.sndAfterBurner = SS_LoadSound("sound/sndAfterBurner.wav");
	global.sndAfterBurnerLong = SS_LoadSound("sound/sndAfterBurnerLong.wav");
	global.sndAfterBurnerStop = SS_LoadSound("sound/sndAfterBurnerStop.wav");
