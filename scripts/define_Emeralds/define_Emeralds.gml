function define_Emeralds() {
	emerald_c[0]=make_color_hsv(0,224,255);
	emerald_c[1]=make_color_hsv(32,224,255);
	emerald_c[2]=make_color_hsv(80,224,255);
	emerald_c[3]=make_color_hsv(120,224,255);
	emerald_c[4]=make_color_hsv(168,224,255);
	emerald_c[5]=make_color_hsv(202,224,255);
	emerald_c[6]=make_color_hsv(0,0,224);


}
